# ============================================================
# ScholarAgent 环境变量模板
# 使用方法：复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---- 大模型（阿里云百炼 / DashScope，OpenAI 兼容模式）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus            # 通用对话/规划
LLM_MODEL_STRONG=qwen-max      # 综述、写作等高质量任务
LLM_MODEL_FAST=qwen-turbo      # 翻译、分类等高频任务
VLM_MODEL=qwen-vl-max          # 扫描件版面理解/公式识别
OCR_MODEL=qwen-vl-ocr          # 扫描件 OCR
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank

# ---- 外部学术服务（可选，提高限额）----
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
CROSSREF_MAILTO=your_email@example.com

# ---- 服务配置 ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=please-change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/scholar.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# ---- 评审测试账号（首次启动自动创建）----
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=change-me

# ---- arXiv 追踪 ----
ARXIV_TRACK_CATEGORIES=cs.CL,cs.LG,cs.AI
ARXIV_TRACK_CRON=0 6 * * *
